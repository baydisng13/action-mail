# ─── Database (you supply this) ───────────────────────────────────────────────
# Neon connection string. Use the POOLED connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# ─── JWT secrets (required) ───────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Google OAuth (optional — "Continue with Google") ─────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ─── Gmail mailbox connect (Gmail API + gmail.modify scope) ───────────────────
# Enable "Gmail API" in Google Cloud, add this redirect URI, and add the
# gmail.modify scope on the OAuth consent screen. Add yourself as a test user.
GMAIL_CONNECT_REDIRECT_URI="http://localhost:3000/api/mailbox/google/callback"
# Encrypts stored mailbox OAuth tokens at rest. openssl rand -base64 32
MAILBOX_ENCRYPTION_KEY=""
# Authenticates internal self-invoked sync steps + cron. openssl rand -base64 32
SYNC_SECRET=""

# ─── AI layer (swappable — DeepSeek by default) ───────────────────────────────
# DeepSeek key from platform.deepseek.com. Swap AI_MODEL/AI_BASE_URL for other
# OpenAI-compatible providers (OpenAI, OpenRouter, Groq, local, …).
AI_API_KEY=""
AI_MODEL="deepseek-chat"
AI_BASE_URL="https://api.deepseek.com/v1"

# ─── Email (optional in dev — links log to the server console) ────────────────
RESEND_API_KEY=""
EMAIL_FROM="Postscript <onboarding@resend.dev>"

# ─── Client ───────────────────────────────────────────────────────────────────
# Leave empty for same-origin API calls.
VITE_API_URL=""
VITE_APP_TITLE="Postscript"
