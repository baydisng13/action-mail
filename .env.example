# ─── Required ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
# Public URLs of the web app and the api
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32   (encrypts mailbox credentials and stored metadata)
MAILBOX_ENCRYPTION_KEY=

# Comma separated emails that see the platform admin console
PLATFORM_ADMIN_EMAILS=

# ─── Optional: features show "not configured" until set ──────────────────────
# Google sign-in + Gmail connect (console.cloud.google.com > Credentials).
# Redirect URIs: <API_URL>/api/auth/google/callback and <API_URL>/api/mailbox/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (any OpenAI-compatible API; DeepSeek by default)
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com/v1

# Transactional email (Resend). Without it, sign-ups are verified at once.
RESEND_API_KEY=
EMAIL_FROM=Postscript <onboarding@resend.dev>

# Billing (polar.sh). Webhook URL: <API_URL>/api/billing/webhook
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_TEAM_MONTHLY=
POLAR_PRODUCT_TEAM_YEARLY=

SYNC_INTERVAL_MINUTES=10
